// Clicksp database schema (Phase 3).
//
// The schema is split per module in this folder. Conventions
// (.claude/skills/database-architect/references/conventions.md):
// - tables snake_case plural (@@map), columns snake_case (@map);
// - primary keys are UUIDv7 generated by the database (gen_uuid_v7());
// - money is BIGINT integer Rial with a currency_code beside it;
// - translatable text lives in <entity>_translations (fa required, en optional);
// - CHECK constraints, triggers and append-only rules Prisma cannot express are
//   in the hand-written SQL migrations and documented in docs/DATABASE.md.

generator client {
  provider        = "prisma-client"
  output          = "../../src/generated/prisma"
  moduleFormat    = "esm"
  // Partial unique indexes (soft-delete aware uniqueness). Kept in the Prisma
  // schema so `prisma migrate diff` reports no drift against the SQL migrations.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}
