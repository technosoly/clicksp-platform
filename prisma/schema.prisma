// Clicksp database schema.
// Phase 2 sets up the connection and tooling only. The full schema
// (identity, catalog, motorcycles, inventory, sales, accounting, shipping,
// content, system) is added in Phase 3 with SQL migrations for triggers and
// constraints. See docs/ROADMAP.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}
