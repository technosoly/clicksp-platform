# Copy to .env and fill in. Never commit .env.
# Values below are placeholders, not working credentials.

# --- Application ---
# APP_ENV: development | staging | production
APP_ENV=development
APP_URL=http://localhost:3000
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# --- Authentication ---
# Required for sign-in (encrypts two-factor secrets, keys SMS code hashes).
# At least 32 characters. Generate one: openssl rand -base64 48
# Changing it later makes existing two-factor setups unusable (re-enrolment needed).
AUTH_SECRET=

# Header the reverse proxy sets to the client IP: x-real-ip | x-forwarded-for
TRUSTED_IP_HEADER=x-real-ip

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=clicksp
POSTGRES_USER=clicksp
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
# Used by the app and Prisma when running outside Docker (pnpm dev):
DATABASE_URL=postgresql://clicksp:change-me-local-only@localhost:5432/clicksp

# --- Redis (rate limiting, short-lived caches) ---
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379
REDIS_URL=redis://:change-me-local-only@localhost:6379

# --- Meilisearch (product search) ---
MEILI_ENV=development
MEILI_MASTER_KEY=change-me-at-least-16-bytes
MEILI_PORT=7700
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=change-me-at-least-16-bytes

# --- Uploaded images ---
# Folder for uploaded images when no S3-compatible storage is configured.
# Use an absolute path outside the build output: `pnpm start` runs from
# .next/standalone, where a relative default (.data/media) would be wiped by
# the next build. Docker sets /app/.data/media on a volume. Include it in backups.
MEDIA_STORAGE_DIR=

# --- S3-compatible object storage (not used yet; an adapter comes with deployment) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Pluggable providers (chosen later by the owner) ---
# SMS_PROVIDER: none | console
#   none: customer phone sign-in shows "not available yet"
#   console: development only (pnpm dev), prints the code in the terminal; refused in production
SMS_PROVIDER=none
# Empty until real gateway credentials exist
PAYMENT_PROVIDERS=
